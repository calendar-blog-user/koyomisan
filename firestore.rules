rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 通知トークンの登録(新規作成)は誰でも可能。
    // 更新(都市の変更・再登録)は、そのトークン本人の書き込みだけ許可。
    // 読み取り・削除はクライアントから一切許可しない(Admin SDKのみ可能)。
    match /subscribers/{token} {
      allow create: if request.resource.data.keys().hasAll(["token", "registeredAt"])
                    && request.resource.data.token == token;
      allow update: if request.resource.data.token == token;
      allow read, delete: if false;
    }
    // それ以外のコレクションはすべて拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
